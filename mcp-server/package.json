{
  "name": "genuine-reviews-mcp",
  "version": "0.1.0",
  "description": "MCP server that removes likely fake reviews and keeps genuine ones. Works with Claude and ChatGPT.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild src/server.mjs --bundle --platform=node --format=esm --target=node18 --minify --outfile=../plugin/server/genuine-reviews.mjs --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "start": "node ../plugin/server/genuine-reviews.mjs",
    "start:http": "node ../plugin/server/genuine-reviews.mjs --http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "node-html-parser": "7.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  }
}

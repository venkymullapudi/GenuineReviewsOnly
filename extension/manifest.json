{
  "manifest_version": 3,
  "name": "GenuineReviewsOnly",
  "version": "0.1.0",
  "description": "Hides likely fake, paid or incentivised reviews so you only see genuine ones.",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "GenuineReviewsOnly" },
  "icons": { "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["scorer.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": { "gecko": { "id": "genuinereviewsonly@example.org" } }
}
